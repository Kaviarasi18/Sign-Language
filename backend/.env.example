# Path to local pretrained Keras model checkpoint
ISL_MODEL_PATH=../model/weights/isl-translate-v1.keras

# Optional path to companion LSTM classifier weights (standard Sequential layers)
ISL_CLASSIFIER_WEIGHTS_PATH=../model/weights/isl_model_final.keras

# Allowed CORS origin for local Vite/Express development
CORS_ORIGIN=http://localhost:3000

# Default confidence threshold for predictions (0.0 - 1.0)
DEFAULT_CONFIDENCE_THRESHOLD=0.35
